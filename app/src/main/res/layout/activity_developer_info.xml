<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="0dp">

    <!-- Toolbar: En üstte -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/developerToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5E9FD8"
        android:title="Hakkında"
        android:titleTextColor="@android:color/white"
        android:elevation="4dp" />

    <!-- Ana İçerik Ortada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/raport_logo"
            android:layout_marginBottom="32dp"
            android:scaleType="centerCrop"/>

        <!-- Başlık -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SafeDose"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"/>

        <!-- Alt Başlık / Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doğru Doz, Güvenli Tedavi"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

    </LinearLayout>

    <!-- Alt Kartı: Bilgiler -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="@drawable/rounded_card_background"
        android:padding="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by Students of Computer Information Systems"
            android:textSize="14sp"
            android:textColor="#5E9FD8"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:layout_gravity="center_horizontal"/>

        <!-- Geliştirici İsimleri -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avni Kahraman"
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Betül Koç"
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUAYYUM ADEYEMI"
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <!-- Teşekkür -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supervised by: Prof. Dr. Nadire ÇAVUŞ"
            android:textSize="13sp"
            android:textColor="#5E9FD8"
            android:textStyle="italic"
            android:layout_gravity="center_horizontal"/>

    </LinearLayout>

</RelativeLayout>